{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wielorzeczownik/.github"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/validate\\.yml$/",
        "/^scripts/test-matrix\\.sh$/"
      ],
      "matchStrings": [
        "(?<depName>php):(?<currentValue>\\d+\\.\\d+-cli)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/validate\\.yml$/",
        "/^scripts/test-matrix\\.sh$/",
        "/^docker/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n[^\\n]*?(?:_VERSION=|[a-z][a-z_-]*: )(?<currentValue>[^\\s\"]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^docker/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\n[^\\n]*?_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["php"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["php"],
      "groupName": "php test images",
      "semanticCommitType": "test"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["phalcon/cphalcon", "phpunit/phpunit"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["phalcon/phalcon"],
      "matchUpdateTypes": ["major"],
      "labels": ["upstream drift"]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["phalcon/cphalcon", "phalcon/phalcon"],
      "groupName": "phalcon test versions",
      "semanticCommitType": "test"
    },
    {
      "matchPackageNames": ["laravel/pint"],
      "allowedVersions": "<1.30.5"
    },
    {
      "matchPackageNames": ["phpunit/phpunit"],
      "allowedVersions": "<12.0.0",
      "groupName": "phpunit"
    },
    {
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "playwright"
    },
    {
      "matchFileNames": ["e2e/**"],
      "semanticCommitType": "test"
    },
    {
      "matchFileNames": ["docker/**"],
      "semanticCommitType": "test"
    }
  ]
}
